# --- Secrets / local LLM config (NEVER commit the keyless GPT-5.5 endpoint) ---
.env
**/conf/llm/local.yaml
**/conf/llm/local.*.yaml
secrets/
*.secret.yaml

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.venvs/

# --- Run outputs / large artifacts ---
runs/
*.log
.fs_cache/

# raw run logs (curated record lives in experiments/LOG.md)
experiments/*.out

# --- Internal planning docs (kept local, not shipped) ---
GOAL.md
plan.md
docs/

# Public, source-checked experiment protocol (other planning drafts stay local).
!docs/
docs/*
!docs/edgebench_science_experiment_addendum.md

# Second-hardening review record referenced by the four known_best version notes.
!docs/reviews/
docs/reviews/*
!docs/reviews/new_tasks_difficulty_v2.md
.venv-sle/

# per-run locks held by scripts/run_cohort.sh
.locks/
