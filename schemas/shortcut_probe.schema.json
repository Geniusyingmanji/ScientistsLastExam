{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sle:shortcut-probe:1",
  "title": "TASK_CARD.yaml shortcut_probe",
  "type": "object",
  "required": [
    "schema_version",
    "metric",
    "reference",
    "probes",
    "relative_margin",
    "score_tolerance"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "metric": {
      "const": "combined_score"
    },
    "reference": {
      "type": "object",
      "required": [
        "candidate",
        "expected_score"
      ],
      "properties": {
        "candidate": {
          "type": "string",
          "minLength": 1
        },
        "expected_score": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "probes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "candidate",
          "expected_score",
          "id"
        ],
        "properties": {
          "candidate": {
            "type": "string",
            "minLength": 1
          },
          "expected_score": {
            "type": [
              "number",
              "null"
            ]
          },
          "id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "relative_margin": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 0.3
    },
    "score_tolerance": {
      "type": "number",
      "minimum": 0,
      "exclusiveMaximum": 0.05
    }
  },
  "$comment": "The runtime validator additionally rejects non-finite numbers, duplicate ids/candidates, absolute or escaping paths, and absent candidate files. The relative_margin maximum is the runtime policy ceiling (MARGIN_CEILING); a wider margin is a review decision that raises the ceiling, not a card value."
}
